  "presets": {
    "none": {
      "label": "자막 없음",
      "note": "자막을 끄는 상태값. 렌더러는 아무것도 그리지 않는다.",
      "mode": "none",
      "enter": {
        "dur": 0,
        "ease": "linear",
        "from": {}
      },
      "hold": {},
      "exit": {
        "dur": 0,
        "ease": "linear",
        "to": {}
      },
      "per": "page",
      "stagger": 0,
      "style": {},
      "ass": {
        "mode": "none"
      }
    },
    "outline-basic": {
      "label": "기본 외곽선",
      "note": "가장 조용한 기본값. 0.16초 페이드 + 0.1em 상승 진입, 짧은 페이드 아웃.",
      "mode": "line",
      "enter": {
        "dur": 0.16,
        "ease": "outSoft",
        "from": {
          "opacity": 0,
          "dy": 0.1
        }
