  "seo": {
    "title_max_chars": 40,
    "title_rules": [
      "검색어를 앞쪽에",
      "숫자·괄호로 시선 잡기",
      "감탄부호 1개까지",
      "제목에 #Shorts 넣지 않는다(설명/태그로)"
    ],
    "tags_count": [
      5,
      15
    ],
    "hashtags": [
      "#Shorts",
      "#쇼츠"
    ],
    "description_template": "{한줄요약}\n\n{핵심 3줄}\n\n{출처/크레딧}\n\n#Shorts #{주제태그}",
    "pinned_comment_template": "{영상에서 못다한 한 줄}\n{질문 하나} — 댓글로 알려주세요!",
    "upload_time_kst": [
      "18:00",
      "23:00"
    ]
  },
  "speed_ramp": {
    "note": "한 클립 안에서 속도가 점진적으로 바뀐다. 소리가 있으면 구간 분할(구간마다 setpts + atempo, 마지막 concat)이 기본이고 영상만 있으면 setpts 표현식(ramp_timemap_expr)이 오차 없이 매끄럽다. references/ffmpeg-recipes.md 22번.",
    "defaults": {
      "base_speed": 1.0,
      "strength": 0.5,
      "segments": 8,
      "min_base_speed": 0.5,
      "max_base_speed": 2.0,
      "strength_range": [
        0.0,
        0.85
      ],
      "span_range": [
        0.2,
        1.0
      ]
    },
    "formula": "speed(u) = base_speed * (1 ± k ∓ 2k·u) / (1 ∓ k ± 2k·|2u-1|)  (k=strength, u=구간 진행도 0~1)",
    "modes": [
      {
        "id": "up",
        "name": "서서히 빠르게",
        "expr": "1 - k + 2*k*u",
        "snippet": "trim=start={a}:end={b},setpts=(PTS-STARTPTS)/{s},fps=30  +  atrim=start={a}:end={b},asetpts=PTS-STARTPTS,atempo={s}",
        "use": "도입은 천천히, 후반 몰아치기"
      },
      {
        "id": "down",
        "name": "서서히 느리게",
        "expr": "1 + k - 2*k*u",
        "snippet": "trim=start={a}:end={b},setpts=(PTS-STARTPTS)/{s},fps=30  +  atrim=start={a}:end={b},asetpts=PTS-STARTPTS,atempo={s}",
        "use": "엔딩 감속"
      },
      {
        "id": "highlight",
        "name": "하이라이트 감속",
        "expr": "1 - k + 2*k*abs(2*u-1)",
        "snippet": "trim=start={a}:end={b},setpts=(PTS-STARTPTS)/{s},fps=30  +  atrim=start={a}:end={b},asetpts=PTS-STARTPTS,atempo={s}",
        "use": "빠르게 → 느리게 → 빠르게 (핵심 대사 강조)"
      },
      {
        "id": "jump",
        "name": "점프 가속",
        "expr": "1 + k - 2*k*abs(2*u-1)",
        "snippet": "trim=start={a}:end={b},setpts=(PTS-STARTPTS)/{s},fps=30  +  atrim=start={a}:end={b},asetpts=PTS-STARTPTS,atempo={s}",
        "use": "느리게 → 빠르게 → 느리게 (중간 강조)"
      }
    ],
    "ramp_timemap_expr": {
      "note": "영상 전용(소리 없음). 속도 s(t)=s0*(1+a*t) 일 때 t_out = ln(1+a*t)/(s0*a). atempo는 시간에 따라 변하는 값을 못 받으므로 오디오에는 못 쓴다.",
      "vf": "setpts=(1/({s0}*{a}))*log(1+{a}*T)/TB,fps=30",
      "verified": "6초 0.5625x→1.4375x: 이론 6.434초 / 실제 6.43초"
    },
    "verified": {
      "segment_split": "6초 8구간 0.5625x→1.4375x: 이론 6.525초 / 실제 6.61초(+1.3%, 프레임 경계 손실). 경계를 1/30초에 맞추면 0.1초 안쪽",
      "pitch": "구간마다 오디오 피크 440.0Hz 유지(atempo)"
    }
  },
  "pitch_presets": [
    {
      "id": "lock",
      "name": "음정 유지",
      "rate": "{r}",
      "audio": "atempo={r}",
      "note": "기본. 배속이 변해도 목소리 음정 그대로 (검증: 1.5배속 4.00초 · 피크 440.3Hz)"
