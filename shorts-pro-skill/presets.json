{
  "schema": "shorts-pro/presets@1",
  "version": "1.2.0",
  "updated": "2026-11-24",
  "locale": "ko-KR",
  "notes": [
    "이 파일은 shorts-pro 스킬의 단일 기준(single source of truth)이다. 스크립트와 문서가 모두 이 파일을 읽는다.",
    "수정 후 반드시 `python3 -c \"import json;json.load(open('presets.json'))\"`로 검증한다.",
    "색상은 #RRGGBB(문서/HTML용)와 &HAABBGGRR(ASS 자막용)을 함께 적었다. ASS는 BGR 순서다."
  ],
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "aspect": "9:16",
    "duration_target_sec": [
      15,
      45
    ],
    "duration_max_sec": 59,
    "video_codec": "libx264",
    "pix_fmt": "yuv420p",
    "profile": "high",
    "color": {
      "primaries": "bt709",
      "trc": "bt709",
      "colorspace": "bt709"
    },
    "audio": {
      "codec": "aac",
      "bitrate": "192k",
      "sample_rate": 48000,
      "channels": 2,
      "loudness_lufs": -14
    }
  },
  "safe_zones": {
    "strict": {
      "top_px": 288,
      "bottom_px": 672,
      "left_px": 96,
      "right_px": 192,
      "usable_box": {
        "w": 792,
        "h": 960
      },
      "centered_width_px": 696,
      "source": "Meta Reels 광고 가이드(상단 14%, 하단 35%, 좌우 6%) + YouTube Shorts 우측 액션버튼 192px 중 가장 엄격한 값"
    },
    "caption_band": {
      "y_top": 1200,
      "y_bottom": 1450,
      "note": "실전 하단 자막 위치. 설명·채널명 바(하단 672px)와 겹치지 않게 y<=1450을 넘기지 않는다."
    },
    "ui_hints": {
      "right_action_buttons_px": 192,
      "top_search_px": 288,
      "bottom_caption_px": 672
    }
  },
  "encode_presets": [
    {
      "id": "shorts-high",
      "name": "쇼츠 고화질(업로드용)",
      "vf_flags": [
        "-preset",
        "slow",
        "-crf",
        "18"
      ],
      "extra": [
        "-profile:v",
        "high",
        "-level",
        "4.2",
        "-movflags",
        "+faststart"
      ],
      "use": "최종 업로드"
    },
    {
      "id": "shorts-draft",
      "name": "쇼츠 초안(빠른 확인)",
      "vf_flags": [
        "-preset",
        "veryfast",
        "-crf",
        "23"
      ],
      "extra": [
        "-movflags",
        "+faststart"
      ],
      "use": "미리보기/검수"
    },
    {
      "id": "intermediate",
      "name": "중간 렌더(합성 전)",
      "vf_flags": [
        "-preset",
        "veryfast",
        "-crf",
        "16"
      ],
      "extra": [],
      "use": "오버레이 합성 전 컷 작업. 화질 손실 최소화"
    }
  ],
  "color_presets": [
    {
      "id": "basic",
      "name": "기본",
      "eq": {
        "brightness": 0.0,
        "contrast": 1.0,
        "saturation": 1.0
      },
      "colorbalance": null,
      "extra": null
    },
    {
      "id": "vivid",
      "name": "선명하게",
      "eq": {
        "brightness": 0.03,
        "contrast": 1.12,
        "saturation": 1.18
      },
      "colorbalance": {
        "rs": 0.0,
        "gs": 0.0,
        "bs": 0.0
      },
      "extra": "unsharp=5:5:0.6:5:5:0.0"
    },
    {
      "id": "cinema",
      "name": "시네마",
      "eq": {
        "brightness": -0.02,
        "contrast": 1.18,
        "saturation": 0.92
      },
      "colorbalance": {
        "rs": 0.03,
        "gs": 0.0,
        "bs": -0.04
      },
      "extra": "curves=preset=medium_contrast"
    },
    {
      "id": "cool",
      "name": "쿨톤",
      "eq": {
        "brightness": 0.01,
        "contrast": 1.06,
        "saturation": 1.05
      },
      "colorbalance": {
        "rs": -0.06,
        "gs": 0.0,
        "bs": 0.08
      },
      "extra": null
    },
    {
      "id": "warm",
      "name": "웜톤",
      "eq": {
        "brightness": 0.02,
        "contrast": 1.05,
        "saturation": 1.08
      },
      "colorbalance": {
        "rs": 0.08,
        "gs": 0.02,
        "bs": -0.06
      },
      "extra": null
    }
  ],
  "speed_presets": [
    {
      "id": "slow-mo",
      "rate": 0.5,
      "audio": "atempo=0.5",
      "note": "안무 하이라이트. 오디오 피치 유지"
    },
    {
      "id": "slow",
      "rate": 0.75,
      "audio": "atempo=0.75",
      "note": "감정선 강조"
    },
    {
      "id": "normal",
      "rate": 1.0,
      "audio": null,
      "note": "원본"
    },
    {
      "id": "fast",
      "rate": 1.25,
      "audio": "atempo=1.25",
      "note": "정보형 호흡 압축"
    },
    {
      "id": "faster",
      "rate": 1.5,
      "audio": "atempo=1.5",
      "note": "아이돌 직캠·군무 강조"
    },
    {
      "id": "double",
      "rate": 2.0,
      "audio": "atempo=2.0",
      "note": "atempo 상한. 2배 초과는 atempo를 체인"
    },
    {
      "id": "micro-098",
      "rate": 0.98,
      "audio": "atempo=0.98",
      "note": "미세 슬로우. 10초가 10.2초로 늘어남. 호흡을 아주 조금 늘릴 때"
    },
    {
      "id": "micro-101",
      "rate": 1.01,
      "audio": "atempo=1.01",
      "note": "미세 배속(가장 약함). 10초가 9.90초"
    },
    {
      "id": "micro-102",
      "rate": 1.02,
      "audio": "atempo=1.02",
      "note": "미세 배속 기본값. 10초가 9.80초. 화면·소리 어색함이 가장 적다"
    },
    {
      "id": "micro-103",
      "rate": 1.03,
      "audio": "atempo=1.03",
      "note": "미세 배속. 10초가 9.71초"
    },
    {
      "id": "micro-105",
      "rate": 1.05,
      "audio": "atempo=1.05",
      "note": "미세 배속 상한. 20초가 19.05초. 1.05를 넘으면 표정이 빨라 보인다"
    }
  ],
  "micro_variation_presets": [
    {
      "id": "micro-speed",
      "name": "미세 배속만",
      "level": 1,
      "speed": 1.02,
      "vf": "setpts=PTS/1.02,fps=30",
      "af": "atempo=1.02",
      "use": "원본 구도 그대로, 길이·호흡만 2% 바꿈"
    },
    {
      "id": "micro-speed-eq",
      "name": "미세 배속 + 미세 색보정",
      "level": 2,
      "speed": 1.02,
      "eq": {
        "brightness": 0.015,
        "contrast": 1.03,
        "saturation": 1.04,
        "colorbalance": {
          "rs": 0.02,
          "bs": -0.02
        }
      },
      "vf": "eq=brightness=0.015:contrast=1.03:saturation=1.04,colorbalance=rs=0.02:bs=-0.02,setpts=PTS/1.02,fps=30",
      "af": "atempo=1.02",
      "use": "눈에 띄지 않을 만큼만 색을 올림. 톤이 원본과 달라 보이면 수치를 반으로"
    },
    {
      "id": "micro-variation",
      "name": "미세 배속 + 미세 변형(크롭·반전)",
      "level": 3,
      "speed": 1.02,
      "zoom": 1.03,
      "hflip": "optional",
      "vf": "hflip,eq=brightness=0.015:contrast=1.03:saturation=1.04,colorbalance=rs=0.02:bs=-0.02,scale=1080:1920:force_original_aspect_ratio=increase,scale=ceil(iw*1.03/2)*2:ceil(ih*1.03/2)*2,crop=1080:1920,setsar=1,setpts=PTS/1.02,fps=30",
      "af": "atempo=1.02",
      "use": "계정별로 다른 버전을 만들 때 쓰는 최대 조합. hflip을 켜면 화면 안 글자·로고도 뒤집히므로 자막은 반전 후에 얹는다",
      "caution": "변형을 키우면 화질·자막 가독성이 같이 떨어진다. 1.03 크롭은 안전영역을 3% 잃는다."
    }
  ],
  "auto_cut": {
    "detect": "silencedetect=noise=-38dB:d=0.4",
    "defaults": {
      "noise_db": -38,
      "min_silence_sec": 0.4,
      "padding_sec": 0.05,
      "min_keep_sec": 0.12
    },
    "methods": [
      {
        "id": "select",
        "name": "한 번에 점프컷(프레임 드롭)",
        "vf": "select='not(between(t,A,B)+between(t,C,D))',setpts=N/FRAME_RATE/TB",
        "af": "aselect='not(between(t,A,B)+between(t,C,D))',asetpts=N/SR/TB",
        "use": "빠름. 컷 경계가 1프레임(1/30초) 단위"
      },
      {
        "id": "trim-concat",
        "name": "남길 구간만 trim+concat",
        "use": "정확함. 구간 수만큼 trim을 만들고 concat. 구간 사이 오디오가 정확히 붙는다"
      }
    ],
    "caveat": "무음을 0.05초 정도 남기면 컷이 덜 딱딱하고 말 첫 자리가 잘리지 않는다. 반대로 완전히 붙이면 숨소리·박자가 사라져 부자연스러울 수 있다."
  },
  "audio_mix": {
    "fades_sec": [
      0,
      0.3,
      0.5,
      1.0
    ],
    "fade_note": "소리와 화면을 같은 길이로. afade는 amix 뒤(최종 믹스)에 걸어야 BGM까지 같이 페이드된다.",
    "sfx": [
      {
        "id": "pop",
        "name": "팝",
        "synth": "aevalsrc='0.6*sin(2*PI*(880-3600*t)*t)*exp(-28*t)':d=0.15:s=48000",
        "when": "자막·카드 등장"
      },
      {
        "id": "ding",
        "name": "띠링",
        "synth": "aevalsrc='0.45*(sin(2*PI*1318.5*t)+0.5*sin(2*PI*1975.5*t))*exp(-4.5*t)':d=0.8:s=48000",
        "when": "결론·정답 공개"
      },
      {
        "id": "whoosh",
        "name": "스우시",
        "synth": "anoisesrc=d=0.45:c=pink:a=0.5 + highpass=f=500 + afade(in 0.08 / out 0.3)",
        "when": "장면 전환·점프컷"
      },
      {
        "id": "shutter",
        "name": "찰칵",
        "synth": "anoisesrc=d=0.08:c=white:a=0.6 두 번(0ms / 75ms) + highpass=f=1800",
        "when": "사진·비포애프터"
      },
      {
        "id": "punch",
        "name": "타격",
        "synth": "aevalsrc='0.8*sin(2*PI*(150-400*t)*t)*exp(-16*t)':d=0.25:s=48000",
        "when": "강조 컷"
      }
    ],
    "mix": "[1:a]volume=0.9,adelay=2000|2000[fx];[0:a][fx]amix=inputs=2:duration=first:dropout_transition=0[a]",
    "bgm_duck": "threshold=0.05:ratio=8:attack=20:release=350",
    "bgm_volume": 0.3,
    "loudness": "loudnorm=I=-14:TP=-1.5:LRA=11",
    "asplit_note": "원음을 sidechaincompress와 amix 두 곳에 쓸 때는 asplit=2 로 나눈다. 같은 라벨을 두 번 쓰면 FFmpeg가 조용히 원본 입력을 물려 필터를 거치지 않은 소리가 섞인다."
  },
  "typography": {
    "letter_spacing_px": {
      "min": -4,
      "max": 12,
      "step": 1,
      "default": 0
    },
    "line_height": {
      "min": 1.0,
      "max": 1.8,
      "step": 0.05,
      "default": 1.18
