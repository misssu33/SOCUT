    "line_height_by_layout": {
      "subtitle": 1.18,
      "title": 1.12,
      "comment_body": 1.32
    },
    "fonts": {
      "sans": {
        "stack": "Noto Sans CJK KR, Malgun Gothic, Apple SD Gothic Neo, Noto Sans KR, sans-serif",
        "use": "기본"
      },
      "title": {
        "stack": "Black Han Sans, Gmarket Sans, Noto Sans KR, sans-serif",
        "use": "굵은 타이틀"
      },
      "round": {
        "stack": "Cafe24 Ssurround, BMJUA, Nanum Pen Script, Noto Sans KR, sans-serif",
        "use": "둥근 손글씨"
      },
      "serif": {
        "stack": "Nanum Myeongjo, Noto Serif KR, Batang, serif",
        "use": "명조·감성"
      }
    },
    "ass": {
      "letter_spacing": "Style의 Spacing 필드(프리셋 fsp + --letter-spacing)로 넣는다. 음수도 된다.",
      "line_height": "ASS에는 행간 속성이 없어 줄마다 \\an5\\pos(540,y)로 직접 배치한다. gap = fontsize × line-height"
    },
    "html": "overlay.html은 CSS letter-spacing / line-height를 쓴다(SCRIPT.typography).",
    "caution": "자간 +12px, 행간 1.8은 자막이 화면을 넘기 쉽다. 긴 문장은 12자/줄 규칙을 먼저 지킨다."
  },
